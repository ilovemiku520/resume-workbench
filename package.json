{
  "name": "resume-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-conscious resume editor and ChatGPT MCP plugin.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k \"node dist/node/server/index.js\" \"vite --configLoader runner --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/build-widget.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "test": "tsc -p tsconfig.server.json && node --test dist/node/tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "mcp": "node dist/node/server/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "openai": "^7.19.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
